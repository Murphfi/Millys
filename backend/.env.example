# Copiar a .env para desarrollo local, o dar de alta estas mismas claves
# como variables de entorno en Render para producción.

DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require&channel_binding=require
DB_USERNAME=
DB_PASSWORD=

# Base64 de al menos 32 bytes — JwtService falla al arrancar si no lo es.
# Generar uno nuevo con: openssl rand -base64 32
JWT_SECRET=
